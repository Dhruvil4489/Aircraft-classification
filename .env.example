# Environment Configuration for Aircraft Damage Classification and Captioning

# Environment mode: development, testing, production
ENVIRONMENT=development

# Framework flags
TF_ENABLE_ONEDNN_OPTS=0
TF_CPP_MIN_LOG_LEVEL=2
KMP_DUPLICATE_LIB_OK=TRUE

# Paths
DATA_DIR=data/aircraft_damage_dataset_v1
MODELS_DIR=artifacts/models
RESULTS_DIR=artifacts/results
LOGS_DIR=artifacts/logs

# VGG16 Model Hyperparameters (Notebook defaults)
SEED=42
BATCH_SIZE=32
EPOCHS=5
LEARNING_RATE=0.0001
IMAGE_SIZE=224

# BLIP Model Configuration
BLIP_MODEL_ID=Salesforce/blip-image-captioning-base
BLIP_DEVICE=cpu

# API Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
MAX_UPLOAD_SIZE_MB=10

# Optional Enhancements (P2 flags, default OFF)
ENABLE_DATA_AUGMENTATION=false
ENABLE_FINE_TUNING=false
ENABLE_CLASS_WEIGHTS=false
